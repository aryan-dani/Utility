# Firebase client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Prefer <project>.firebaseapp.com. Store/PWA override to the page host at runtime for /__/auth.
# Keep utilityos.tech, www, and planner-flax-six.vercel.app in Firebase Authorized domains.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server / sync scripts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Drive shared folder to sync
GOOGLE_DRIVE_FOLDER_ID=

# App config
# Server-only admin allowlists (used by /api/admin/* and Sync Now)
ADMIN_EMAILS=
# Comma-separated Firebase uids for Google logins without an email claim
ADMIN_UIDS=
# AI provider: "groq" (default) or "bedrock" (Amazon Bedrock with automatic fallback to Groq)
AI_PROVIDER=groq
GROQ_API_KEY=

# Amazon Bedrock (used when AI_PROVIDER=bedrock; never commit real keys)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary credentials or Bedrock API key (alternative to IAM access keys)
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=
# Optional model overrides (defaults shown; use apac.* inference profiles in ap-south-1)
BEDROCK_CHAT_MODEL=us.amazon.nova-lite-v1:0
BEDROCK_FAST_MODEL=us.amazon.nova-micro-v1:0

# Hybrid RAG embeddings (Google AI Studio — NOT a replacement for Groq)
GEMINI_API_KEY=

# Protect /api/webhooks/* (required in production)
CRON_SECRET=

# Optional: URL GitHub Actions POSTs after sync+index (e.g. https://utilityos.tech/api/webhooks/revalidate-content)
VERCEL_REVALIDATE_URL=

# Google Drive OAuth (writable uploads / renames — SA is read-only for Shared Drives)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Ishani campus API (faculty seating, directory, labs) — server-only
# Local: http://127.0.0.1:8001
# Production (Vercel): https://api.aryandani.com
ISHANI_API_URL=

# Preferred for hosted Sync Now: dispatch GitHub Actions (workflow + repo secrets)
GH_PAT=
GITHUB_REPO=

# Upstash Redis REST (required in Vercel production for AI rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Home server (Cloudflare Tunnel). Browser tries origins in order.
NEXT_PUBLIC_UTILITY_API_ORIGINS=https://api.utilityos.tech,https://utility-api.aryandani.com
NEXT_PUBLIC_UTILITY_FILES_ORIGINS=https://files.utilityos.tech,https://utility-files.aryandani.com
# Server-to-server (Vercel → home server /internal/*)
UTILITY_API_URL=https://api.utilityos.tech
UTILITY_API_SECRET=
