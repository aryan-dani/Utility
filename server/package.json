{
  "name": "@utility/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:scheduler": "tsx watch src/scheduler/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "start:scheduler": "node dist/scheduler/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.69",
    "@hono/node-server": "^1.19.17",
    "ai": "^7.0.152",
    "drizzle-orm": "^0.45.4",
    "firebase-admin": "^14.5.0",
    "googleapis": "^188.0.0",
    "hono": "^4.8.3",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "^0.25.4",
    "fast-uri": "^4.2.3",
    "ip-address": "^10.7.4",
    "glob": "^13.0.6",
    "node-domexception": "file:../scripts/domexception-shim",
    "cron-parser": "^5.10.2"
  }
}
