# Copy to /srv/utility/.env and chmod 600. Never commit real values.
# Generate server-only secrets on the host with:
#   openssl rand -hex 32

POSTGRES_PASSWORD=
UTILITY_API_SECRET=
RESTIC_PASSWORD=

# Firebase Admin (same service account as Vercel / Actions)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Drive + AI
GOOGLE_DRIVE_FOLDER_ID=
GROQ_API_KEY=
GEMINI_API_KEY=
ADMIN_EMAILS=

# Optional Drive OAuth (writable uploads)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Vercel revalidate after sync
VERCEL_REVALIDATE_URL=
CRON_SECRET=

# CORS (comma-separated)
CORS_ORIGINS=https://utilityos.tech,https://www.utilityos.tech,https://planner-flax-six.vercel.app

# Cloudflare R2 (restic S3 backend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/utility-backups
AWS_DEFAULT_REGION=auto

# Optional uptime check-ins (Healthchecks.io ping URLs)
HEALTHCHECKS_SYNC_URL=
HEALTHCHECKS_BACKUP_URL=

# Image tag used by deploy/rollback
UTILITY_TAG=latest
