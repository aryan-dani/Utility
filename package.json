{
  "name": "utility",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "cross-env ANALYZE=true npm run build",
    "sync-drive": "node runtime/tools/sync-drive.mjs --incremental",
    "sync-drive:full": "node runtime/tools/sync-drive.mjs --full",
    "upload-drive": "node runtime/tools/upload-drive.mjs",
    "upload-drive:overwrite": "node runtime/tools/upload-drive.mjs --overwrite",
    "drive": "node runtime/index.mjs",
    "index-content": "node runtime/index.mjs index --changed-only",
    "index-content:all": "node runtime/index.mjs index",
    "eval-rag": "node runtime/tools/eval-rag.mjs",
    "deploy:indexes": "node scripts/deploy-firestore-indexes.mjs",
    "check-rag-env": "node scripts/check-rag-env.mjs",
    "sync-all": "node runtime/index.mjs sync --incremental && node runtime/index.mjs index --changed-only",
    "sync-all:full": "node runtime/index.mjs sync --full && node runtime/index.mjs index",
    "rename-drive-files": "node runtime/tools/rename-drive-files.mjs --dry-run",
    "rename-drive-files:apply": "node runtime/tools/rename-drive-files.mjs --apply",
    "audit-drive-site": "node runtime/tools/audit-drive-site.mjs",
    "restructure-drive-years": "node runtime/tools/restructure-drive-years.mjs",
    "restructure-drive-years:apply": "node runtime/tools/restructure-drive-years.mjs --apply",
    "icons:regenerate": "node scripts/regenerate-icons.cjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/react": "^3.0.184",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.182",
    "fflate": "^0.8.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.38.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "node-domexception": "file:./scripts/domexception-shim",
    "officeparser": "^7.0.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.2.6",
    "firebase-tools": "^15.29.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "webpack": "^5.110.3"
  },
  "overrides": {
    "uuid": "^11.0.3",
    "node-domexception": "file:./scripts/domexception-shim",
    "pdfjs-dist": "5.4.296",
    "serialize-javascript": "^7.0.5",
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "@firebase/util": true,
    "esbuild": true,
    "protobufjs": true,
    "re2": true,
    "sharp": true,
    "tesseract.js": true,
    "unrs-resolver": true
  }
}
